    "test:jornada": "node scripts/jornada-de-estudo.mjs",
    "test:estudo": "node scripts/check-study-flow.mjs",
    "test:lumi-chat": "node scripts/check-lumi-chat.mjs",
    "test:visual": "node scripts/check-visual-experience.mjs",
