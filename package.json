    "test:isolamento": "node scripts/check-isolamento.mjs",
    "lumi:celular": "node scripts/ligar-lumi.mjs",
    "avaliar:lumi": "node scripts/avaliar-lumi.mjs",
    "avaliar:lumi-dificil": "node scripts/avaliar-lumi-dificil.mjs",
